meta {
  name: Create Address
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/me/addresses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "label": "Chungi No 8",
    "street": "Qadir abad, Nawabpur road",
    "city": "Multan",
    "state": "PB",
    "postalCode": "10001",
    "country": "PK",
    "isDefault": true
  }
}

