meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Wireless Headphones",
    "description": "Premium noise-cancelling wireless headphones with 30-hour battery life.",
    "category": "Electronics",
    "price": {
      "amountMinor": 9999,
      "currency": "USD"
    },
    "initialStock": 100,
    "attributes": {
      "color": "Black",
      "brand": "AudioTech"
    },
    "images": [
      "https://example.com/images/headphones-front.jpg",
      "https://example.com/images/headphones-side.jpg"
    ]
  }
}

vars:pre-request {
  adminAccessToken: eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IjRZMXF1OXpTYlJxQ3diZEEifQ.eyJyb2xlIjoiQURNSU4iLCJlbWFpbCI6InVzbWFucWFzaW0wOTAwQGdtYWlsLmNvbSIsInN1YiI6IjA1ZmIwYTAzLTViNTktNDRhZi05NWE0LWFjZTY0MGUzNDAzMSIsImlzcyI6InVzZXItc2VydmljZSIsImF1ZCI6ImVjb20tYXBpIiwiaWF0IjoxNzkxMjgzMjc0LCJleHAiOjE3OTEyODQxNzR9.dnSkUWnpkcCd7J9WoRq-W6SHXxFG5X3YOcupQEkCbfoZOXYY9Vt2Qh_CE21Fp336gLIlrxvjMu7oNU07-Gwn4PZ__3KH5_3p6gDVFUL66lGFR4YuAkk8bL0inzrLjNyUxwL9FQejtp8J8H55spLfsxpivB4DwAPj5OqpXyNfTr4irWn79suL5ScMOBtEYTRc82quPCJ6QDThXFtIheKpJipMnc7rrdE-Er0zjyIgdRMIzhH1NbKrYgdZwwuf3vSJl_YDtcevGvwKntcHf4sbrUuq_OWT0p1TeKibuKFYkJSvIOqHhSGW0qAuPs6t4LS7zi_AFHNEFDSJMMrJCfwvcQ
