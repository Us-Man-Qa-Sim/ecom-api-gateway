# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info

# ── HTTP (public — NGINX proxies here in Phase 9) ──
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# ── Downstream gRPC targets (GW-2) ──
# In compose these are the service DNS names; locally, port-forward or use
# `localhost:PORT` matching each service's Dockerfile EXPOSE.
USER_SERVICE_URL=localhost:5001
PRODUCT_SERVICE_URL=localhost:5002
ORDER_SERVICE_URL=localhost:5003

# ── gRPC deadlines (GW-10) ──
# Per-call deadline by profile; the call is cancelled and the client gets 504.
#   fast: single-row reads · standard: mutations/lists · long: fan-outs/admin scans
GRPC_TIMEOUT_FAST_MS=2000
GRPC_TIMEOUT_STANDARD_MS=5000
GRPC_TIMEOUT_LONG_MS=10000

# ── JWT verification (GW-3) ──
# Path to the RSA public key that matches user-service's JWT_PRIVATE_KEY_PATH.
# The gateway never signs — it only verifies. Required outside NODE_ENV=test.
# Copy the file that user-service publishes, e.g.:
#   cp ../user-service/keys/jwt-public.pem ./keys/jwt-public.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
# Must match the values user-service was booted with (user-service defaults
# to these too). If they disagree, every token is rejected as INVALID.
JWT_ISSUER=user-service
JWT_AUDIENCE=ecom-api
# Small skew tolerance for clock drift between the two hosts.
JWT_CLOCK_TOLERANCE_SECONDS=5

# ── Edge hardening (GW-7) ──
# Comma-separated exact-match browser origins (Next.js dev server by default).
CORS_ORIGINS=http://localhost:3001
CORS_CREDENTIALS=false
BODY_LIMIT_JSON=100kb
BODY_LIMIT_URLENCODED=100kb
# Express `trust proxy`. Leave `false` when clients connect directly; set to
# `1` (one hop) behind NGINX so req.ip — and so the rate-limit key — is the
# real client, not the proxy. Also accepts an address/subnet list.
TRUST_PROXY=false

# ── Rate limiting (GW-8) ──
# Global per-IP budget; /auth/* has a stricter fixed 10/min. In-memory, so
# the budget is per gateway instance.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ── OpenAPI / Swagger (GW-9) ──
# `true` mounts the Swagger UI at `/${SWAGGER_PATH}` and the JSON spec at
# `/${SWAGGER_PATH}-json`. Set to `false` in environments where the public
# gateway must not expose the UI.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
